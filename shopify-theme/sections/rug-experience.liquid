{%- comment -%}
  Rugkari — Rug Experience section (Shopify Online Store 2.0)
  Add via: Online Store > Themes > Customize > Product page > Add section > "Rug Experience".
  Tabs: 3D rug (orbit, pile close-up, flip corner to see backing) · In your room
  (photo / live camera / sample room, drag 4 corners, save photo) · Feel the texture
  (magnifier) · Size guide (top-down floor plan with real furniture in feet).
  Optional product metafield custom.flat_image (file, image) = flat top-down rug photo.
{%- endcomment -%}

{%- liquid
  assign rk_sizes = ''
  assign rk_selected = ''
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname contains 'size'
      assign rk_sizes = option.values | join: '|'
      assign rk_selected = option.selected_value
    endif
  endfor
  assign rk_flat = ''
  if product.metafields.custom.flat_image != blank
    assign rk_flat = product.metafields.custom.flat_image.value | image_url: width: 2048
  endif
  assign rk_room = ''
  if section.settings.sample_room != blank
    assign rk_room = section.settings.sample_room | image_url: width: 2000
  endif
-%}

<section class="rkx" id="rkx-{{ section.id }}" style="--rkx-accent: {{ section.settings.accent }};" aria-label="{{ section.settings.heading | escape }}">
  <div class="rkx-wrap page-width">
    <header class="rkx-head">
      {%- if section.settings.eyebrow != blank -%}<p class="rkx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="rkx-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="rkx-sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </header>

    <div class="rkx-tabs" role="tablist">
      <span class="rkx-tab-ink" aria-hidden="true"></span>
      <button type="button" role="tab" class="rkx-tab" data-tab="size" aria-selected="true">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="1.5"/><path d="M7 6v3M11 6v4M15 6v3M19 6v4"/></svg><span class="rkx-tl">Size guide</span><span class="rkx-ts">Size</span>
      </button>
      <button type="button" role="tab" class="rkx-tab" data-tab="zoom" aria-selected="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.8-4.8M8 10.5h5M10.5 8v5"/></svg><span class="rkx-tl">Feel the texture</span><span class="rkx-ts">Texture</span>
      </button>
      <button type="button" role="tab" class="rkx-tab" data-tab="room" aria-selected="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 4l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-9.5Z"/><path d="M7 21v-4.5l5-2 5 2V21"/></svg><span class="rkx-tl">In your room</span><span class="rkx-ts">Room</span>
      </button>
      <button type="button" role="tab" class="rkx-tab" data-tab="3d" aria-selected="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 3 7.5v9L12 21l9-4.5v-9L12 3Z"/><path d="m3 7.5 9 4.5 9-4.5M12 12v9"/></svg><span class="rkx-tl">3D rug</span><span class="rkx-ts">3D</span>
      </button>
    </div>

    <div class="rkx-bar">
      <div class="rkx-sizes" role="radiogroup" aria-label="Rug size"></div>
      <div class="rkx-pick" aria-label="Rug photo used"></div>
    </div>

    <div class="rkx-panel is-active" data-panel="size" role="tabpanel">
      <div class="rkx-stage rkx-size">
        <svg class="rkx-plan" viewBox="0 0 16 12.5" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Floor plan showing the rug with furniture"></svg>
        <div class="rkx-dock">
          <button type="button" class="rkx-chip is-on" data-room="living">Living room</button>
          <button type="button" class="rkx-chip" data-room="bed">Bedroom</button>
          <button type="button" class="rkx-chip" data-room="dining">Dining</button>
        </div>
      </div>
      <div class="rkx-verdict" aria-live="polite"></div>
    </div>

    <div class="rkx-panel" data-panel="zoom" role="tabpanel" hidden>
      <div class="rkx-stage rkx-zoom">
        <img class="rkx-zimg" alt="Rug design, full view" width="1024" height="1536" draggable="false">
        <div class="rkx-lens" aria-hidden="true"></div>
        <div class="rkx-hint rkx-hint-zoom">Move over the rug (or press and slide on phone) to see the wool up close</div>
        <div class="rkx-dock">
          <button type="button" class="rkx-chip is-on" data-z="3">3×</button>
          <button type="button" class="rkx-chip" data-z="5">5×</button>
          <button type="button" class="rkx-chip" data-z="8">8×</button>
        </div>
      </div>
      <ul class="rkx-facts">
        {%- if section.settings.fact_1 != blank -%}<li>{{ section.settings.fact_1 }}</li>{%- endif -%}
        {%- if section.settings.fact_2 != blank -%}<li>{{ section.settings.fact_2 }}</li>{%- endif -%}
        {%- if section.settings.fact_3 != blank -%}<li>{{ section.settings.fact_3 }}</li>{%- endif -%}
      </ul>
    </div>

    <div class="rkx-panel" data-panel="room" role="tabpanel" hidden>
      <div class="rkx-stage rkx-room">
        <div class="rkx-room-default" aria-hidden="true"><i class="rkx-win"></i><i class="rkx-floor"></i><i class="rkx-sofa"></i><i class="rkx-plant"></i></div>
        <img class="rkx-bg" alt="Your room" width="1600" height="1200" hidden>
        <video class="rkx-cam" playsinline muted autoplay hidden></video>
        <img class="rkx-rug" alt="Rug placed in room" width="1000" height="1500" draggable="false">
        <span class="rkx-h" data-i="0"></span><span class="rkx-h" data-i="1"></span><span class="rkx-h" data-i="2"></span><span class="rkx-h" data-i="3"></span>
        <div class="rkx-toast" role="status" hidden></div>
        <div class="rkx-hint rkx-hint-room">Drag the rug to move it · drag the dots to fit it to your floor</div>
        <div class="rkx-dock rkx-dock-room">
          <label class="rkx-chip rkx-chip-strong rkx-upload">Upload room photo<input type="file" accept="image/*" hidden></label>
          <button type="button" class="rkx-chip" data-act="cam">Live camera</button>
          <button type="button" class="rkx-chip" data-act="sample">Sample room</button>
          <button type="button" class="rkx-chip" data-act="rot">Rotate 90°</button>
          <button type="button" class="rkx-chip" data-act="reset">Reset</button>
          <button type="button" class="rkx-chip" data-act="save">Save photo</button>
        </div>
      </div>
      <div class="rkx-sliders">
        <label>Rug size in photo<input type="range" min="60" max="150" value="100" data-sl="scale"></label>
        <label>Match room light<input type="range" min="55" max="130" value="96" data-sl="light"></label>
      </div>
    </div>

    <div class="rkx-panel" data-panel="3d" role="tabpanel" hidden>
      <div class="rkx-stage rkx-3d">
        <div class="rkx-loader"><span></span>Weaving your rug in 3D…</div>
        <div class="rkx-hint rkx-hint-3d">Drag to turn · scroll or +/− to zoom</div>
        <div class="rkx-dim" aria-live="polite"></div>
        <div class="rkx-dock">
          <button type="button" class="rkx-chip" data-view="angle">Angle</button>
          <button type="button" class="rkx-chip" data-view="top">Top</button>
          <button type="button" class="rkx-chip" data-view="close">Pile close-up</button>
          <button type="button" class="rkx-chip rkx-chip-strong" data-act="flip" aria-pressed="false">Flip corner</button>
          <span class="rkx-sep"></span>
          <button type="button" class="rkx-icon" data-act="zout" aria-label="Zoom out">−</button>
          <button type="button" class="rkx-icon" data-act="zin" aria-label="Zoom in">+</button>
        </div>
      </div>
      <p class="rkx-note">Real proportions for the size you pick. "Flip corner" shows the backing, the way you would check a rug in a showroom.</p>
    </div>
  </div>

  <script type="application/json" class="rkx-data">
    {
      "title": {{ product.title | json }},
      "sizes": {{ rk_sizes | split: '|' | json }},
      "selected": {{ rk_selected | json }},
      "flat": {{ rk_flat | json }},
      "room": {{ rk_room | json }},
      "pile": {{ section.settings.pile | default: 1 }},
      "backing": {{ section.settings.backing | json }},
      "images": [
        {%- for image in product.images -%}
          {"src": {{ image | image_url: width: 2048 | json }}, "thumb": {{ image | image_url: width: 160 | json }}, "ratio": {{ image.aspect_ratio | default: 1 }}, "alt": {{ image.alt | json }}}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
</section>

<style>
  .rkx{--rkx-ink:#1d1a17;--rkx-mute:#6f675f;--rkx-line:rgba(29,26,23,.12);--rkx-paper:#f7f4ef;--rkx-card:#fff;--rkx-glass:rgba(255,255,255,.78);--rkx-r:18px;color:var(--rkx-ink);padding:clamp(40px,6vw,88px) 0;background:var(--rkx-paper)}
  .rkx *{box-sizing:border-box}
  .rkx-wrap{max-width:1180px;margin:0 auto;padding:0 16px}
  .rkx-head{text-align:center;max-width:640px;margin:0 auto 28px}
  .rkx-eyebrow{font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--rkx-mute);margin:0 0 10px}
  .rkx-title{font-size:clamp(28px,4vw,44px);line-height:1.08;letter-spacing:-.02em;margin:0 0 12px;font-weight:600}
  .rkx-sub{color:var(--rkx-mute);font-size:16px;line-height:1.55;margin:0}

  .rkx-tabs{position:relative;display:flex;gap:4px;margin:0 auto 18px;padding:5px;background:#ebe5dc;border-radius:999px;width:max-content;max-width:100%;overflow-x:auto;scrollbar-width:none}
  .rkx-tabs::-webkit-scrollbar{display:none}
  .rkx-tab-ink{position:absolute;top:5px;bottom:5px;left:5px;border-radius:999px;background:var(--rkx-card);box-shadow:0 1px 2px rgba(0,0,0,.06),0 4px 14px rgba(0,0,0,.06);transition:transform .45s cubic-bezier(.2,.8,.2,1),width .45s cubic-bezier(.2,.8,.2,1)}
  .rkx-tab{position:relative;z-index:1;display:flex;align-items:center;gap:8px;border:0;background:none;padding:10px 18px;border-radius:999px;font:inherit;font-size:14px;font-weight:500;color:var(--rkx-mute);cursor:pointer;white-space:nowrap;transition:color .3s}
  .rkx-tab[aria-selected="true"]{color:var(--rkx-ink)}
  .rkx-ts{display:none}
  .rkx-tab svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linejoin:round;stroke-linecap:round}

  .rkx-bar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}
  .rkx-sizes{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;padding:2px}
  .rkx-sizes::-webkit-scrollbar{display:none}
  .rkx-size-btn{flex:none;border:1px solid var(--rkx-line);background:var(--rkx-card);color:var(--rkx-ink);border-radius:10px;padding:8px 12px;font:inherit;font-size:13px;cursor:pointer;transition:all .2s;font-variant-numeric:tabular-nums}
  .rkx-size-btn:hover{border-color:var(--rkx-ink)}
  .rkx-size-btn[aria-checked="true"]{background:var(--rkx-accent,#1d1a17);border-color:var(--rkx-accent,#1d1a17);color:#fff}
  .rkx-pick{display:flex;gap:6px;align-items:center}
  .rkx-pick:empty{display:none}
  .rkx-pick small{font-size:12px;color:var(--rkx-mute);margin-right:4px}
  .rkx-thumb{width:40px;height:40px;border-radius:10px;border:2px solid transparent;padding:0;overflow:hidden;cursor:pointer;background:#ddd;outline-offset:2px}
  .rkx-thumb img{width:100%;height:100%;object-fit:cover;display:block}
  .rkx-thumb[aria-pressed="true"]{border-color:var(--rkx-accent,#1d1a17)}

  .rkx-panel[hidden]{display:none}
  .rkx-panel.is-active{animation:rkxIn .5s cubic-bezier(.2,.8,.2,1)}
  @keyframes rkxIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  .rkx-stage{position:relative;width:100%;aspect-ratio:16/10;border-radius:var(--rkx-r);overflow:hidden;background:#e9e3da;box-shadow:inset 0 0 0 1px var(--rkx-line);user-select:none;-webkit-user-select:none}
  .rkx-3d{background:radial-gradient(120% 90% at 50% 0%,#fbf9f6 0%,#ece6dd 55%,#ddd5ca 100%);cursor:grab;touch-action:pan-y}
  .rkx-3d:active{cursor:grabbing}
  .rkx-3d canvas{position:absolute;inset:0;width:100%!important;height:100%!important;display:block}
  .rkx-loader{position:absolute;inset:0;display:grid;place-content:center;justify-items:center;gap:14px;color:var(--rkx-mute);font-size:14px;transition:opacity .5s}
  .rkx-loader span{width:34px;height:34px;border-radius:50%;border:2px solid var(--rkx-line);border-top-color:var(--rkx-ink);animation:rkxSpin 1s linear infinite}
  .rkx-loader.is-done{opacity:0;pointer-events:none}
  @keyframes rkxSpin{to{transform:rotate(360deg)}}
  .rkx-hint{position:absolute;top:14px;left:50%;transform:translateX(-50%);background:var(--rkx-glass);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);padding:7px 14px;border-radius:999px;font-size:12.5px;color:var(--rkx-ink);white-space:nowrap;pointer-events:none;transition:opacity .6s;max-width:calc(100% - 28px);overflow:hidden;text-overflow:ellipsis;z-index:3}
  .rkx-hint.is-gone{opacity:0}
  .rkx-dim{position:absolute;top:14px;right:14px;font-size:12px;color:var(--rkx-mute);font-variant-numeric:tabular-nums;z-index:2}
  .rkx-dock{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);display:flex;align-items:center;gap:6px;padding:6px;background:var(--rkx-glass);backdrop-filter:blur(14px) saturate(1.4);-webkit-backdrop-filter:blur(14px) saturate(1.4);border-radius:999px;box-shadow:0 8px 30px rgba(0,0,0,.12),inset 0 0 0 1px rgba(255,255,255,.6);max-width:calc(100% - 20px);overflow-x:auto;scrollbar-width:none;z-index:4}
  .rkx-dock::-webkit-scrollbar{display:none}
  .rkx-chip{flex:none;border:0;background:transparent;color:var(--rkx-ink);font:inherit;font-size:13px;font-weight:500;padding:8px 13px;border-radius:999px;cursor:pointer;transition:background .2s,color .2s;white-space:nowrap}
  .rkx-chip:hover{background:rgba(0,0,0,.06)}
  .rkx-chip.is-on,.rkx-chip[aria-pressed="true"]{background:var(--rkx-ink);color:#fff}
  .rkx-chip-strong{background:var(--rkx-accent,#1d1a17);color:#fff}
  .rkx-chip-strong:hover{background:var(--rkx-accent,#1d1a17);opacity:.9}
  .rkx-icon{flex:none;width:34px;height:34px;border-radius:50%;border:0;background:rgba(0,0,0,.05);font:inherit;font-size:18px;line-height:1;cursor:pointer;color:var(--rkx-ink)}
  .rkx-sep{flex:none;width:1px;height:20px;background:var(--rkx-line);margin:0 2px}
  .rkx-note{font-size:13px;color:var(--rkx-mute);text-align:center;margin:12px 0 0}
  .rkx button:focus-visible,.rkx label:focus-within{outline:2px solid var(--rkx-accent,#1d1a17);outline-offset:2px}

  .rkx-room{background:#d9d1c6;touch-action:none}
  .rkx-room-default,.rkx-bg,.rkx-cam{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .rkx-room-default{background:linear-gradient(180deg,#f1ece5 0%,#e7e0d6 54%,#cdbfae 54.4%,#cdbfae 55.4%,transparent 55.4%);overflow:hidden}
  .rkx-win{position:absolute;left:8%;top:9%;width:22%;height:38%;background:linear-gradient(160deg,#fffdf8,#f4efe6);box-shadow:inset 0 0 0 6px #fbf8f3,0 0 60px 30px rgba(255,250,238,.55);border-radius:3px}
  .rkx-win::after{content:"";position:absolute;inset:6px;background:linear-gradient(90deg,transparent 49%,#fbf8f3 49%,#fbf8f3 51%,transparent 51%),linear-gradient(0deg,transparent 49%,#fbf8f3 49%,#fbf8f3 51%,transparent 51%)}
  .rkx-floor{position:absolute;left:-60%;right:-60%;top:55.4%;height:90%;transform-origin:top;transform:perspective(520px) rotateX(58deg);background:repeating-linear-gradient(90deg,#c7a57c 0 70px,#b8956b 70px 71px,#cdac84 71px 140px,#b48f66 140px 141px,#c39f75 141px 210px,#b8956b 210px 211px),#c7a57c}
  .rkx-floor::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(60,40,20,.28),transparent 45%),radial-gradient(60% 40% at 25% 10%,rgba(255,248,230,.35),transparent)}
  .rkx-sofa{position:absolute;right:9%;top:33%;width:40%;height:25%;background:linear-gradient(180deg,#9aa39a,#7f897f);border-radius:14px 14px 6px 6px;box-shadow:0 18px 30px -12px rgba(0,0,0,.35)}
  .rkx-sofa::before{content:"";position:absolute;left:-5%;right:-5%;bottom:0;height:52%;background:linear-gradient(180deg,#8e978e,#737c73);border-radius:12px 12px 6px 6px}
  .rkx-plant{position:absolute;left:36%;top:30%;width:6%;height:25%;background:radial-gradient(circle at 50% 30%,#5f7a55 0 38%,transparent 39%),linear-gradient(#b9a58b,#a38d72) bottom/70% 34% no-repeat;border-radius:4px}
  .rkx-rug{position:absolute;left:0;top:0;transform-origin:0 0;cursor:move;filter:drop-shadow(0 6px 10px rgba(0,0,0,.28));will-change:transform;z-index:1;max-width:none}
  .rkx-h{position:absolute;width:26px;height:26px;margin:-13px 0 0 -13px;border-radius:50%;background:#fff;box-shadow:0 2px 10px rgba(0,0,0,.35),inset 0 0 0 7px var(--rkx-accent,#1d1a17);cursor:grab;z-index:2;touch-action:none}
  .rkx-h::after{content:"";position:absolute;inset:-12px;border-radius:50%}
  .rkx-dock-room{bottom:12px}
  .rkx-toast{position:absolute;left:50%;top:56px;transform:translateX(-50%);background:var(--rkx-ink);color:#fff;font-size:13px;padding:9px 16px;border-radius:12px;z-index:5;max-width:calc(100% - 28px);text-align:center}
  .rkx-upload{display:inline-flex;align-items:center}
  .rkx-sliders{display:grid;grid-template-columns:1fr 1fr;gap:12px 28px;margin-top:14px}
  .rkx-sliders label{display:grid;gap:6px;font-size:13px;color:var(--rkx-mute)}
  .rkx-sliders input{width:100%;accent-color:var(--rkx-accent,#1d1a17)}

  .rkx-zoom{background:#efe9e1;display:grid;place-items:center;touch-action:none;cursor:none}
  .rkx-zimg{position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);max-width:86%;max-height:76%;width:auto;height:auto;display:block;box-shadow:0 30px 50px -25px rgba(0,0,0,.45);border-radius:2px}
  .rkx-lens{position:absolute;width:220px;height:220px;border-radius:50%;pointer-events:none;opacity:0;transform:scale(.6);transition:opacity .25s,transform .25s;background-repeat:no-repeat;background-color:#fff;box-shadow:0 20px 50px rgba(0,0,0,.35),inset 0 0 0 4px rgba(255,255,255,.95),inset 0 0 30px rgba(0,0,0,.25);z-index:3}
  .rkx-lens.is-on{opacity:1;transform:scale(1)}
  .rkx-facts{list-style:none;display:flex;flex-wrap:wrap;justify-content:center;gap:8px 22px;margin:16px 0 0;padding:0;font-size:13.5px;color:var(--rkx-mute)}
  .rkx-facts li::before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--rkx-accent,#1d1a17);margin-right:8px;vertical-align:middle}

  .rkx-size{background:#f4efe8;display:grid;place-items:center}
  .rkx-plan{width:100%;height:100%;padding:14px 14px 70px}
  .rkx-plan text{font-family:inherit}
  .rkx-verdict{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:14px;font-size:14px}
  .rkx-verdict span{background:var(--rkx-card);border:1px solid var(--rkx-line);border-radius:999px;padding:8px 14px}
  .rkx-verdict b{font-weight:600}

  @media (max-width:749px){
    .rkx-stage{aspect-ratio:4/5}
    .rkx-tab{padding:9px 13px;font-size:13px}
    .rkx-tab svg{display:none}
    .rkx-tl{display:none}.rkx-ts{display:inline}
    .rkx-tabs{width:100%;justify-content:space-between}.rkx-tab{flex:1;justify-content:center}
    .rkx-sliders{grid-template-columns:1fr}
    .rkx-lens{width:160px;height:160px}
    .rkx-dim{top:auto;bottom:70px;right:12px}
    .rkx-hint{top:10px;font-size:11.5px}
  }
  @media (prefers-reduced-motion:reduce){.rkx *{animation:none!important;transition:none!important}}
</style>

<script>
(function () {
  if (window.RKX) { window.RKX.boot(); return; }
  var THREE_SRC = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';

  function parseSize(s) {
    var m = String(s || '').match(/(\d+(?:\.\d+)?)\s*(?:ft|feet|')?\s*[x×*]\s*(\d+(?:\.\d+)?)\s*(cm|ft|feet|')?/i);
    if (!m) return null;
    var a = +m[1], b = +m[2];
    if (m[3] && /cm/i.test(m[3])) { a /= 30.48; b /= 30.48; }
    return { w: Math.min(a, b), l: Math.max(a, b), label: String(s).trim() };
  }
  function abs(u) { return u && u.indexOf('//') === 0 ? 'https:' + u : u; }
  function fmt(n) { return (Math.round(n * 10) / 10).toString(); }
  function loadImg(src) {
    return new Promise(function (res, rej) {
      var i = new Image(); i.crossOrigin = 'anonymous';
      i.onload = function () { res(i); }; i.onerror = rej; i.src = src;
    });
  }
  var scriptP = null;
  function loadThree() {
    if (window.THREE) return Promise.resolve();
    if (!scriptP) scriptP = new Promise(function (res, rej) {
